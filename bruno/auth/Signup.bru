meta {
  name: Signup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.token);
    bru.setVar("userId", res.body.user_id);
  }
}
